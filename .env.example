# APP_URL: The public URL where TapShare is hosted (used for QR codes & email links).
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT=3000

# DATA_DIR: Optional directory for storing uploaded files and share metadata.
DATA_DIR="./data"

# Direct server email (Option 1: SMTP, e.g. smtp.gmail.com with an App Password)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Direct server email (Option 2: Resend API key)
RESEND_API_KEY=""
